{
  "schema": 1,
  "full_threshold": 20,
  "full_patterns": ["CMakeLists.txt", "CMakePresets.json", "cmake/**", ".github/**", "scripts/**", "src/editor/imageeditor.h"],
  "ignored_patterns": ["docs/**", "README.md", "licenses/**", "tests/image/**", ".gitignore", "CMakeLists.txt.user"],
  "targets": {
    "colorPipelineTests": "colorPipelineTests",
    "detailProcessingTests": "detailProcessingTests",
    "imageExportTests": "imageExportTests",
    "colorMixerMathTests": "colorMixerMathTests",
    "colorMixerNeutralTests": "colorMixerNeutralProbe",
    "colorMixerQmlTests": "colorMixerQmlTests",
    "settingsQmlTests": "settingsQmlTests",
    "imageViewportQmlTests": "imageViewportQmlTests",
    "uiPreferencesTests": "uiPreferencesTests",
    "uiPreferencesQmlTests": "uiPreferencesQmlTests",
    "rawDecoderTests": "rawDecoderTests",
    "rawBlackLevelEstimatorTests": "rawBlackLevelEstimatorTests",
    "cameraProfileEngineTests": "cameraProfileEngineTests"
  },
  "python_suites": {
    "selection": "test_build_windows.py",
    "color_mixer_analysis": "test_analyse_color_mixer.py",
    "noise_analysis": "test_analyse_noise.py"
  },
  "rules": [
    {"patterns": ["src/core/ColorMixer.*", "src/qml/ColorMixerModule.qml"], "tests": ["colorMixerMathTests", "colorMixerNeutralTests", "colorMixerQmlTests", "imageExportTests", "settingsQmlTests"], "python": ["color_mixer_analysis"]},
    {"patterns": ["src/core/ColorPipeline.*"], "tests": ["colorPipelineTests", "imageExportTests", "colorMixerNeutralTests", "rawDecoderTests", "cameraProfileEngineTests"]},
    {"patterns": ["src/core/DetailProcessing.*"], "tests": ["detailProcessingTests", "colorPipelineTests", "imageExportTests"], "python": ["noise_analysis"]},
    {"patterns": ["src/editor/imageeditor.cpp"], "tests": ["colorPipelineTests", "imageExportTests", "colorMixerMathTests", "colorMixerNeutralTests", "colorMixerQmlTests", "settingsQmlTests"]},
    {"patterns": ["src/app/UiPreferences.*", "config/**"], "tests": ["uiPreferencesTests", "uiPreferencesQmlTests", "settingsQmlTests"]},
    {"patterns": ["src/raw/RawDecoder.*"], "tests": ["rawDecoderTests", "rawBlackLevelEstimatorTests", "cameraProfileEngineTests", "imageExportTests"]},
    {"patterns": ["src/raw/RawBlackLevelEstimator.*"], "tests": ["rawBlackLevelEstimatorTests", "rawDecoderTests"]},
    {"patterns": ["src/profiles/**", "profiles/index.json"], "tests": ["cameraProfileEngineTests", "rawDecoderTests", "imageExportTests"]},
    {"patterns": ["src/cache/**", "src/providers/**", "src/app/main.cpp", "src/qml/Main.qml", "src/qml/ThumbnailRibbon.qml", "src/qml/ImageInfoPanel.qml"], "tests": ["imageExportTests", "settingsQmlTests", "uiPreferencesQmlTests", "imageViewportQmlTests"]},
    {"patterns": ["src/qml/ImageViewport.qml"], "tests": ["imageViewportQmlTests", "uiPreferencesQmlTests"]},
    {"patterns": ["tests/image_viewport_qml_test.cpp"], "tests": ["imageViewportQmlTests"]},
    {"patterns": ["src/qml/Setting.qml", "src/qml/SettingsSection.qml", "src/qml/AdjustmentControl.qml", "src/qml/CurveChannelButton.qml", "src/qml/HistogramModule.qml", "src/qml/ToneCurveModule.qml", "src/qml/ColorGradingModule.qml"], "tests": ["settingsQmlTests", "colorMixerQmlTests", "uiPreferencesQmlTests"]},
    {"patterns": ["tests/color_pipeline_test.cpp"], "tests": ["colorPipelineTests"]},
    {"patterns": ["tests/detail_processing_test.cpp"], "tests": ["detailProcessingTests"]},
    {"patterns": ["tests/image_export_test.cpp"], "tests": ["imageExportTests"]},
    {"patterns": ["tests/color_mixer_math_test.cpp"], "tests": ["colorMixerMathTests"]},
    {"patterns": ["tests/color_mixer_neutral_probe.cpp"], "tests": ["colorMixerNeutralTests"]},
    {"patterns": ["tests/color_mixer_qml_test.cpp"], "tests": ["colorMixerQmlTests"]},
    {"patterns": ["tests/settings_qml_test.cpp"], "tests": ["settingsQmlTests"]},
    {"patterns": ["tests/ui_preferences_test.cpp"], "tests": ["uiPreferencesTests"]},
    {"patterns": ["tests/ui_preferences_qml_test.cpp"], "tests": ["uiPreferencesQmlTests"]},
    {"patterns": ["tests/raw_decoder_test.cpp"], "tests": ["rawDecoderTests"]},
    {"patterns": ["tests/raw_black_level_estimator_test.cpp"], "tests": ["rawBlackLevelEstimatorTests"]},
    {"patterns": ["tests/camera_profile_engine_test.cpp"], "tests": ["cameraProfileEngineTests"]},
    {"patterns": ["tests/analyse_color_mixer.py"], "tests": [], "python": ["color_mixer_analysis", "noise_analysis"]},
    {"patterns": ["tests/test_analyse_color_mixer.py"], "tests": [], "python": ["color_mixer_analysis"]},
    {"patterns": ["tests/analyse_noise.py", "tests/test_analyse_noise.py"], "tests": [], "python": ["noise_analysis"]},
    {"patterns": ["tests/test_build_windows.py"], "tests": [], "python": ["selection"]}
  ]
}
