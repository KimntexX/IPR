 "runner_source": "\"\"\"Audit exact paired plateaus in native working RGB; not sensor clipping identification.\"\"\"\nfrom datetime import datetime, timezone\nimport gc\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom study_noise_neighbourhoods import ROOT, sha256, git\n\n\nLUMA = np.array([.2627002120112671, .6779980715188708, .0593017164698620], dtype=np.float32).astype(float)\nINVERSE = np.linalg.inv(np.array([LUMA, [1.,0.,-1.], [-.5,1.,-.5]]))\n\n\ndef channel_plateau(a, b):\n    if a.shape != b.shape or not np.isfinite(a).all() or not np.isfinite(b).all() or not a.size:\n        raise ValueError('Matched nonempty finite channels required')\n    levels, counts = np.unique(a, return_counts=True)\n    index = int(np.argmax(counts)); mode = float(levels[index])\n    return dict(mode_a=mode, mode_a_fraction=float(counts[index]/a.size),\n        shared_mode_fraction=float(np.mean((a == mode)&(b == mode))),\n        exact_a_equals_b_fraction=float(np.mean(a == b)),\n        differential_std=float(np.std((a-b)/np.sqrt(2))),\n        a_percentiles=dict(zip(('p001','p01','p50','p99','p999'),np.quantile(a,[.001,.01,.5,.99,.999]).tolist())))\n\n\ndef run():\n    names = ('origine-rejets-spectraux-paires-bruit-v001-20261027T190151Z.json',\n        'transport-psd-gaussien-filtre-spectral-bruit-v002-20261027T190615Z.json',\n        'contextes-abstention-axes-bruit-v001-20261026T221702Z.json',\n        'paires-supplementaires-axes-bruit-v001-20261026T222302Z.json',\n        'paires-supplementaires-axes-bruit-v002-20261026T222833Z.json')\n    paths = [ROOT/'docs/validation/raw'/n for n in names]; hashes = [sha256(p) for p in paths]\n    previous = json.loads(paths[0].read_text(encoding='utf-8')); records = []\n    for dataset, path in enumerate(paths[2:]):\n        data = json.loads(path.read_text(encoding='utf-8'))\n        for pair in data['records']:\n            planes = [np.asarray(pair[k]['native']['original_y_co_cg']).reshape(3,256,256) for k in ('a','b')]\n            rgb = [np.einsum('ab,byx->ayx',INVERSE,p) for p in planes]\n            prior = next(r for r in previous['records'] if r['dataset'] == dataset and r['a'] == pair['a']['native']['raw'])\n            row = dict(dataset=dataset,iso=pair['iso'],a=prior['a'],b=prior['b'],\n                quiet_stable_tiles=sum(t['quiet'] and t['stable'] for t in prior['tiles']),\n                mean_physical_y=float(((planes[0][0]+planes[1][0])*.5).mean()),\n                y_co_cg=[channel_plateau(a,b) for a,b in zip(*planes)],\n                rgb=[channel_plateau(a,b) for a,b in zip(*rgb)])\n            records.append(row)\n            print(dataset,pair['iso'],'quiet',row['quiet_stable_tiles'],'Y',round(row['mean_physical_y'],5),\n                'same YCoCg',[round(c['exact_a_equals_b_fraction'],4) for c in row['y_co_cg']],\n                'shared RGB mode',[round(c['shared_mode_fraction'],4) for c in row['rgb']],flush=True)\n        del data, planes, rgb\n        gc.collect()\n    if [sha256(p) for p in paths] != hashes: raise ValueError('Changed evidence')\n    now = datetime.now(timezone.utc)\n    output = ROOT/'docs/validation/raw'/f'plateaux-paires-natives-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result = dict(schema_version=1,data_version=1,completed_at_utc=now.isoformat(),records=records,\n        numpy_version=np.__version__,commit=git('rev-parse','HEAD'),runner_sha256=sha256(Path(__file__)),\n        runner_source=Path(__file__).read_text(encoding='utf-8'),\n        parents=[dict(path=str(p),sha256=h) for p,h in zip(paths,hashes)],\n        rules='Exact equality/modes measured on existing native linear YCoCg and inverse workingRec2020 RGB,never TIFF. Report all12pairs,including excluded ones. No hard1.0white threshold or assertion ofsensor saturation;no source decoder,profile or denoiser changes.',\n        limitations='Working-master plateau doesnot locate origin: sensor,openingclipping,profile/nonlinearity/quantization. InverseRGB rounding may hide exact equality;originalYCoCg also retained. Modefrequencynot noisequality;reproducible/FPN maycancel inD. No newphotos or calibrationfit.')\n    with output.open('x',encoding='utf-8') as handle: json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print(output,flush=True)\n\n\nif __name__ == '__main__': run()\n",
