 "completed_at_utc": "2026-10-26T17:57:57.735427+00:00",
 "commit": "2a40c5c6cff78d40294393a68827f4a24555c724",
 "runner_sha256": "8ca135adfe7583ccc36ddc1f48863b8bb1f641abd0d07e5c775dffa465af7d5c",
 "runner_source": "\"\"\"Test a fixed instantaneous noise mixing across distinct capture covariances.\"\"\"\nfrom datetime import datetime, timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom study_noise_neighbourhoods import ROOT, git, sha256\n\n\ndef off_diagonal(matrix):\n    result = matrix.copy()\n    for i in range(3):\n        result[..., i, i] = 0.\n    return result\n\n\ndef joint_diagonalizer(covariances):\n    covariances = np.asarray(covariances, dtype=float)\n    if covariances.ndim!=3 or covariances.shape[1:]!=(3,3) or not np.isfinite(covariances).all():\n        raise ValueError('Finite three-channel covariance set required')\n    trace = np.trace(covariances, axis1=1, axis2=2)\n    if np.any(trace<=0):raise ValueError('Positive covariance traces required')\n    normalized = covariances/trace[:,None,None]\n    average = np.mean(normalized, axis=0)\n    values,vectors = np.linalg.eigh(average)\n    if values.min() <= values.max()*1e-8:raise ValueError('Insufficient covariance rank')\n    whitening=(vectors/np.sqrt(values))@vectors.T\n    transformed=np.einsum('ai,kij,bj->kab',whitening,normalized,whitening)\n    transform=whitening.copy();history=[float(np.sum(off_diagonal(transformed)**2))]\n    for sweep in range(100):\n        for p,q in ((0,1),(0,2),(1,2)):\n            directions=np.stack((transformed[:,p,q],.5*(transformed[:,q,q]-transformed[:,p,p])),axis=1)\n            _,eigen=np.linalg.eigh(directions.T@directions)\n            direction=eigen[:,0]\n            if direction[0]<0:direction=-direction\n            angle=.5*np.arctan2(direction[1],direction[0]);c,s=np.cos(angle),np.sin(angle)\n            rotation=np.eye(3);rotation[p,p]=c;rotation[q,q]=c;rotation[p,q]=-s;rotation[q,p]=s\n            transformed=np.einsum('ia,kij,jb->kab',rotation,transformed,rotation)\n            transform=rotation.T@transform\n        cost=float(np.sum(off_diagonal(transformed)**2));history.append(cost)\n        if cost>history[-2]+1e-10:raise ValueError('Joint diagonalization objective increased')\n        if history[-2]-cost<1e-13*max(1.,history[-2]):break\n    return transform,whitening,history\n\n\ndef score(covariance, transform):\n    transformed=transform@covariance@transform.T\n    standard=np.sqrt(np.diag(transformed))\n    correlation=transformed/(standard[:,None]*standard[None,:])\n    return dict(off_diagonal_energy_fraction=float(np.sum(off_diagonal(transformed)**2)/np.sum(transformed**2)),\n        max_abs_axis_correlation=float(np.max(np.abs(off_diagonal(correlation)))),\n        axis_correlation=correlation.tolist())\n\n\ndef covariance_record(pair):\n    arrays=[np.asarray(next(s for s in pair[k]['samples'] if s['kind']=='flat')['original_y_co_cg'],dtype=float).reshape(3,64,64)\n            for k in ('a','b')]\n    difference=(arrays[0]-arrays[1])/np.sqrt(2)\n    cov=np.cov(difference.reshape(3,-1),bias=True)\n    return cov,dict(a=pair['a']['raw'],b=pair['b']['raw'],iso=pair['a']['iso'],\n        covariance_physical_y_co_cg=cov.tolist(),mean_y_co_cg=((arrays[0]+arrays[1])*.5).mean(axis=(1,2)).tolist())\n\n\ndef run():\n    paths=[ROOT/'docs/validation/raw'/name for name in (\n        'extraction-paires-profils-bruit-v001-20261026T174656Z.json',\n        'etude-reelle-bornee-nonlocal-bruit-v001-20261025T222336Z.json')]\n    hashes=[sha256(p) for p in paths];training,held=[json.loads(p.read_text(encoding='utf-8')) for p in paths]\n    train=[covariance_record(p) for p in training['native']['pairs']]\n    test=[covariance_record(p) for p in held['native']['pairs']]\n    transform,whitening,history=joint_diagonalizer([c for c,_ in train])\n    inverse=np.linalg.inv(transform)\n    if not np.allclose(transform@inverse,np.eye(3),atol=1e-10):raise ValueError('Invalid transform inverse')\n    records=[]\n    for split,rows in (('train',train),('held',test)):\n        for cov,metadata in rows:\n            records.append(dict(split=split,**metadata,scores={name:score(cov,mat) for name,mat in (\n                ('original_axes',np.eye(3)),('pooled_whitening',whitening),('fixed_joint_axes',transform))}))\n    if [sha256(p) for p in paths]!=hashes:raise ValueError('Parents changed')\n    now=datetime.now(timezone.utc)\n    output=ROOT/'docs/validation/raw'/f\"melange-fixe-covariances-bruit-v001-{now.strftime('%Y%m%dT%H%M%SZ')}.json\"\n    result=dict(schema_version=1,data_version=1,completed_at_utc=now.isoformat(),commit=git('rev-parse','HEAD'),\n        runner_sha256=sha256(Path(__file__)),runner_source=Path(__file__).read_text(encoding='utf-8'),\n        parents=[dict(path=str(p),sha256=h) for p,h in zip(paths,hashes)],records=records,\n        fixed_transform=transform.tolist(),inverse_transform=inverse.tolist(),training_objective_history=history,\n        rules='Hypothesis Ck=M diag(vk) M^T for constantmixing,differentchannelvariances. PhysicalYCoCg covariances,NOTindependentperplane normalization;only trace-normalize eachtrainingcovariance for equalweight acrossISO. Whitenmeantrainingmatrix,Jacobi3x3jointrotations,max100sweeps,monotone training objective. Fit4traincaptures ONLY;score4differentheldcaptures. No denoising orvariance regression.',\n        limitations='Zero-lag second-order model only;approximate diagonalization not sensor-axis identification proof. Spatialcrossspectra/nonlinearRCD/median/DCPJacobian and samplingerror can violatefixedmixing. Pair residual possiblemotion/scene. Fourtrain/testpairs previously explored,not untouched camera validation. Axis signs/order arbitrary;not newcolourspace orproductionprofile.')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print(output,flush=True)\n    for r in records:print(r['split'],r['iso'],r['scores']['fixed_joint_axes'],flush=True)\n\n\nif __name__=='__main__':run()\n",
