 },
 "runner_source": "\"\"\"Parameter-free output-contract audit of the frozen shared-chroma experiment.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom PIL import Image,ImageDraw,ImageCms\nfrom study_noise_burst_shared_chroma import rgb\nfrom study_noise_burst_reference import align\nfrom audit_noise_burst_reference import display\nfrom analysis.render import available_memory\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\n\ndef project(planes):\n    \"\"\"Compress toward same-Y grey only where working RGB would be negative; HDR retained.\"\"\"\n    p=np.asarray(planes,float)\n    if not np.isfinite(p).all() or np.min(p[0])<0:raise ValueError('Finite nonnegative luminance required')\n    minimum=rgb(p).min(axis=-1);y=p[0]\n    scale=np.ones_like(y);bad=minimum<0\n    scale[bad]=y[bad]/np.maximum(y[bad]-minimum[bad],1e-30)\n    # Numerical margin for the final float32 archive, not a quality parameter.\n    scale[bad]*=1-4*np.finfo(np.float32).eps\n    out=p.copy();out[1:]*=scale\n    return out.astype(np.float32),scale\n\n\ndef run():\n    started=datetime.now(timezone.utc)\n    if (available_memory() or 0)<2*1024**3:raise ValueError('Need2GiB for reference-conditioned crop audit')\n    names=('chroma-partagee-rafale-bruit-v001-20261027T232722Z.json',\n        'temoins-production-rafale-bruit-v001-20261027T230748Z.json',\n        'wiener-bandes-rafale-bruit-v001-20261027T231611Z.json',\n        'contextes-reference-rafale-bruit-v001-20261027T232645Z.json')\n    paths=[ROOT/'docs/validation/raw'/name for name in names];hashes=[sha256(p) for p in paths]\n    data=[json.loads(p.read_text(encoding='utf-8')) for p in paths];arrays=[]\n    for parent in (data[0],data[1],data[3]):\n        p=Path(parent['pixels']['path'])\n        if sha256(p)!=parent['pixels']['sha256']:raise ValueError('Changed archive')\n        with np.load(p,allow_pickle=False) as saved:arrays.append(saved['planes'].copy())\n    candidate,production,reference=arrays;records=[];outputs=[]\n    folder=ROOT/'build-patch_noise/burst-shared-chroma-safe'/started.strftime('%Y%m%dT%H%M%SZ');folder.mkdir(parents=True,exist_ok=False)\n    contact=Image.new('RGB',(5*224,4*240),(35,35,35));draw=ImageDraw.Draw(contact)\n    for col,label in enumerate(('Original','Production100','Shared before*','Shared constrained*','Reference14*')):draw.text((col*224+5,5),label,fill='white')\n    for ki,target in enumerate((0,4,8,13)):\n        group=[]\n        for roi in range(9):\n            before=candidate[ki,roi];after,scale=project(before);group.append(after)\n            if not np.array_equal(after[0],production[ki,2,roi,0]):raise ValueError('Y invariant broken')\n            old=next(r for r in data[2]['records'] if r['target_index']==target and r['region']==roi)\n            sampled=[]\n            for j,matrix in enumerate(old['target_to_reference_affines']):\n                m=np.asarray(matrix,float);m[:,2]+=128;sampled.append(align(reference[j,roi],m))\n            sampled=np.stack(sampled)[:,:,:,32:-32][:,:,32:-32,:];valid=np.isfinite(sampled).all(axis=(0,1))\n            if valid.mean()<.8:raise ValueError('Reference overlap no longer valid')\n            a=sampled[::2].mean(axis=0);b=sampled[1::2].mean(axis=0)\n            variants=np.stack((production[ki,2,roi],before,after))[:,:,32:-32,32:-32]\n            risk=np.mean((variants[...,valid]-a[...,valid])*(variants[...,valid]-b[...,valid]),axis=-1)\n            record=dict(target_index=target,region=roi,cross_reference_risk=risk.tolist(),\n                projected_delta_vs_production100=(risk[2]-risk[0]).tolist(),projection_delta_vs_frozen=(risk[2]-risk[1]).tolist(),\n                luminance_max_abs_delta_vs_production100=float(np.max(abs(after[0]-production[ki,2,roi,0]))),\n                compressed_pixel_fraction=float(np.mean(scale[32:-32,32:-32]<1)),minimum_scale=float(scale.min()),\n                rgb_min_before=float(rgb(before[:,32:-32,32:-32]).min()),rgb_min_after=float(rgb(after[:,32:-32,32:-32]).min()),\n                negative_rgb_test_threshold=-1e-7,\n                rgb_negative_fraction_before=float(np.mean(rgb(before[:,32:-32,32:-32]) < -1e-7)),\n                rgb_negative_fraction_after=float(np.mean(rgb(after[:,32:-32,32:-32]) < -1e-7)),\n                chroma_mean_change_due_projection=np.mean(after[1:,32:-32,32:-32]-before[1:,32:-32,32:-32],axis=(-2,-1)).tolist())\n            if record['rgb_negative_fraction_after']!=0:raise ValueError('Working RGB nonnegative contract failed')\n            records.append(record)\n            if target==0 and roi in (0,2,4,8):\n                row=(0,2,4,8).index(roi);draw.text((5,row*240+25),f'ROI{roi}: *reference-conditioned, not single-image deployable',fill='white')\n                ref=np.where(np.isfinite((a+b)/2),(a+b)/2,production[ki,0,roi,:,32:-32,32:-32])\n                pictures=[production[ki,0,roi,:,32:-32,32:-32],variants[0],variants[1],variants[2],ref]\n                for col,picture in enumerate(pictures):contact.paste(Image.fromarray(display(picture)),(col*224+16,row*240+40))\n        outputs.append(group)\n    archive=folder/'projected-shared-chroma.npz'\n    with archive.open('xb') as handle:np.savez_compressed(handle,planes=np.asarray(outputs,np.float32))\n    picture=folder/'shared-chroma-output-contract.png';contact.save(picture,icc_profile=ImageCms.ImageCmsProfile(ImageCms.createProfile('sRGB')).tobytes())\n    if hashes!=[sha256(p) for p in paths]:raise ValueError('Changed parents')\n    now=datetime.now(timezone.utc);output=ROOT/'docs/validation/raw'/f'contrat-chroma-partagee-rafale-bruit-v002-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    previous=ROOT/'docs/validation/raw/contrat-chroma-partagee-rafale-bruit-v001-20261027T232945Z.json'\n    prior=json.loads(previous.read_text(encoding='utf-8'))\n    numerical_keys=('cross_reference_risk','projected_delta_vs_production100','projection_delta_vs_frozen',\n        'luminance_max_abs_delta_vs_production100','compressed_pixel_fraction','minimum_scale','rgb_min_before','rgb_min_after')\n    if any(new[k]!=old[k] for new,old in zip(records,prior['records']) for k in numerical_keys):raise ValueError('Metadata correction changed numerical results')\n    result=dict(schema_version=1,data_version=2,started_at_utc=started.isoformat(),completed_at_utc=now.isoformat(),\n        correction=dict(parent=dict(path=str(previous),sha256=sha256(previous)),reason='Clarify numericthresholdfieldnames:explicit -1e-7. Same reconstruction/scores verified exactly;not new independent study.'),\n        parents=[dict(path=str(p),sha256=h) for p,h in zip(paths,hashes)],records=records,\n        pixels=dict(path=str(archive),sha256=sha256(archive)),preview=dict(path=str(picture),sha256=sha256(picture)),\n        runner_source=Path(__file__).read_text(encoding='utf-8'),runner_sha256=sha256(Path(__file__)),commit=git('rev-parse','HEAD'),\n        rules='Fixed deterministic physicaloutputconstraint after frozen sharedchroma,NOvariance/gain/windowretuning. SameYgreycompressionCoCgscalaronlyifnegativeworkingRGB. PreserveYandHDR;no upper1clip. Numericalmargin4float32eps. Reportprojectionrisk/DCimpact;no DC restoration after projection since that could breaknonnegativity.',\n        limitations='Feasibility remainsreference-conditioned on samecamera/sceneISO4000;notdeployable singleimage or independentfinalvalidation. WorkingRec2020nonnegativitynotdisplay sRGBgamutmapping. Referencealignmentimperfect. No production/merge/push/tag or sealed decode.',\n        verdict='bounded_reference_conditioned_chroma_experiment_not_stable_product')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('RESULT',output,'PREVIEW',picture,flush=True)\n\n\nif __name__=='__main__':run()\n",
