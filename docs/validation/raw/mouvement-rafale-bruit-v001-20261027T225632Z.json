 "runner_sha256": "db5d37acab547d626ac323cbc588f9228e8d4fd403c5c1a49395b99e7b2d6fc4",
 "runner_source": "\"\"\"Development-only global burst motion audit; estimates transforms, does not resample RAW pixels.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport rawpy\nimport cv2\nfrom analysis.render import available_memory\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\n\ndef preview(raw):\n    h,w=raw.shape;image=raw[:h//2*2,:w//2*2].reshape(h//2,2,w//2,2).mean(axis=(1,3)).astype(np.float32)\n    target=(800,round(image.shape[0]*800/image.shape[1]))\n    small=cv2.resize(image,target,interpolation=cv2.INTER_AREA)\n    a,b=np.quantile(small,[.01,.99])\n    if b<=a:raise ValueError('Unmeasurable scene preview')\n    return np.clip((small-a)/(b-a),0,1),[image.shape[1]/target[0],image.shape[0]/target[1]]\n\n\ndef estimate(reference,current):\n    a=(reference*255).astype(np.uint8);b=(current*255).astype(np.uint8)\n    points=cv2.goodFeaturesToTrack(a,maxCorners=500,qualityLevel=.01,minDistance=8,blockSize=5)\n    if points is None or len(points)<12:raise ValueError('Insufficient global scene features')\n    tracked,status,error=cv2.calcOpticalFlowPyrLK(a,b,points,None,winSize=(21,21),maxLevel=3)\n    if tracked is None or status is None:raise ValueError('Optical flow failed')\n    valid=status.ravel()!=0\n    if valid.sum()<12:raise ValueError('Insufficient tracked features')\n    matrix,inliers=cv2.estimateAffinePartial2D(points[valid],tracked[valid],method=cv2.RANSAC,ransacReprojThreshold=1.5,maxIters=2000,confidence=.99,refineIters=10)\n    if matrix is None or inliers is None:raise ValueError('Global motion fit failed')\n    projected=cv2.transform(points[valid],matrix);residual=np.linalg.norm(projected-tracked[valid],axis=2).ravel()\n    chosen=inliers.ravel()!=0\n    return dict(reference_to_frame_preview_affine=matrix.tolist(),tracked_points=int(valid.sum()),inliers=int(chosen.sum()),\n        inlier_fraction=float(chosen.mean()),median_inlier_residual_preview_pixels=float(np.median(residual[chosen])),\n        rotation_degrees=float(np.degrees(np.arctan2(matrix[1,0],matrix[0,0]))),scale=float(np.hypot(matrix[0,0],matrix[1,0])))\n\n\ndef run():\n    source=ROOT/'docs/validation/raw/audit-rafale-reelle-bruit-v001-20261027T225328Z.json';digest=sha256(source)\n    parent=json.loads(source.read_text(encoding='utf-8'));started=datetime.now(timezone.utc);records=[];reference=None\n    cv2.setRNGSeed(440)\n    for item in parent['identities']:\n        if item['split']!='development':continue\n        if (available_memory() or 0)<2*1024**3:raise ValueError('Need2GiB per RAW motion audit')\n        p=Path(item['path'])\n        if sha256(p)!=item['sha256']:raise ValueError('Source changed')\n        with rawpy.imread(str(p)) as raw:current,scale=preview(raw.raw_image_visible)\n        if reference is None:reference=current.copy()\n        result=estimate(reference,current);result.update(path=str(p),sha256=item['sha256'],index=item['index'],preview_to_cfa_plane_scale=scale)\n        records.append(result);print('MOTION',p.name,'rotation',result['rotation_degrees'],'inliers',result['inliers'],flush=True)\n    if len(records)!=14 or sha256(source)!=digest:raise ValueError('Incomplete/changed motion audit')\n    now=datetime.now(timezone.utc);output=ROOT/'docs/validation/raw'/f'mouvement-rafale-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result=dict(schema_version=1,data_version=1,started_at_utc=started.isoformat(),completed_at_utc=now.isoformat(),records=records,\n        parent=dict(path=str(source),sha256=digest),runner_sha256=sha256(Path(__file__)),runner_source=Path(__file__).read_text(encoding='utf-8'),\n        commit=git('rev-parse','HEAD'),opencv_version=cv2.__version__,verdict='development_global_motion_only',\n        rules='First14ONLY,no validation/sealed decode. CFA2x2meanthen800widepreview,own1/99percentilerange.500ShiTomasi,LK21x21pyramid3,RANSACpartialaffine1.5previewpx. Estimateglobalgeometryonly,no RAWresampling/registrationbasednoisecalibration.',\n        limitations='Singleaffinecannotmodelparallax/nonrigidmotion/rollingreadout. Previewquantization/noiseaffectsfeaturepositions. MotionfitnotguaranteealignedcleantruthorvalidphysicalPTC. Inlierselectionnotnoisepixelselection. No production.')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('RESULT',output,flush=True)\n\n\nif __name__=='__main__':run()\n",
 "commit": "2a40c5c6cff78d40294393a68827f4a24555c724",
