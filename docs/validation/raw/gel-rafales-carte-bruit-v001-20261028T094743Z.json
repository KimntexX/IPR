 "runner_sha256": "0cd451c1c7f3c3cabf4fde2d1fc9bcd50aeebe8e2aabde2a264329abf0b682ad",
 "runner_source": "\"\"\"Read-only qualification of explicitly scoped new card bursts; no profile fit.\"\"\"\nfrom datetime import datetime, timezone\nfrom itertools import combinations\nimport json\nimport mmap\nfrom pathlib import Path\nimport platform\n\nimport numpy as np\nimport rawpy\n\nfrom audit_noise_pairs import metadata, pair_stats, matching\nfrom study_noise_neighbourhoods import ROOT, sha256, git\n\n\ndef group_bursts(frames, gap_seconds=4):\n    groups=[]\n    for frame in frames:\n        previous=groups[-1][-1] if groups else None\n        timestamp=datetime.strptime(frame['metadata']['datetime'],'%Y:%m:%d %H:%M:%S')\n        prior=datetime.strptime(previous['metadata']['datetime'],'%Y:%m:%d %H:%M:%S') if previous else None\n        if (previous is None or not matching(previous['metadata'],frame['metadata']) or\n                not 0 <= (timestamp-prior).total_seconds() <= gap_seconds):\n            groups.append([])\n        groups[-1].append(frame)\n    return groups\n\n\ndef stack_moments(stack):\n    \"\"\"Separate drift and centered spatial covariance; signed estimates, no clipping.\"\"\"\n    stack=np.asarray(stack,dtype=np.float64)\n    if stack.ndim!=3 or stack.shape[0]<2 or min(stack.shape[1:])<2 or not np.isfinite(stack).all():\n        raise ValueError('Need at least two finite equal two-dimensional planes')\n    n=stack.shape[0]\n    means=stack.mean(axis=(1,2))\n    centered=stack-means[:,None,None]\n    pixels=stack.shape[1]*stack.shape[2]\n    temporal=float(np.var(stack,axis=0,ddof=1).mean())\n    centered_temporal=float(np.var(centered,axis=0,ddof=1).mean()*pixels/(pixels-1))\n    marginal=float(np.var(stack,axis=(1,2),ddof=1).mean())\n    mean_spatial=float(np.var(centered.mean(axis=0),ddof=1))\n    common=mean_spatial-centered_temporal/n\n    if not np.isclose(marginal-centered_temporal,common,atol=1e-8,rtol=1e-9):\n        raise ValueError('Finite-sample variance decomposition inconsistent')\n    return dict(frame_means_dn=means.tolist(),mean_range_dn=float(np.ptp(means)),\n        raw_temporal_variance_dn2=temporal,\n        centered_temporal_variance_dn2=centered_temporal,\n        average_single_spatial_variance_dn2=marginal,\n        burst_mean_spatial_variance_dn2=mean_spatial,\n        estimated_shared_spatial_variance_dn2=common,\n        signed_shared_fraction=common/marginal if marginal>0 else None)\n\n\ndef run():\n    started=datetime.now(timezone.utc)\n    source_root=Path('D:/DCIM/100EOSR6')\n    paths=[source_root/f'6V1A{i:04}.CR3' for i in range(9861,9933)]\n    if any(not p.is_file() for p in paths):raise ValueError('Expected new card range incomplete')\n    parent=ROOT/'docs/validation/raw/audit-domaine-raw-bruit-v001-20261028T092101Z.json'\n    parent_hash=sha256(parent)\n    domain=json.loads(parent.read_text(encoding='utf-8'))\n    darks={(int(r['folder'].split('-')[1]),r['plane']):r for r in domain['records'] if 'points' in r}\n    frames=[]\n    for path in paths:\n        stat=path.stat()\n        with path.open('rb') as stream:\n            with mmap.mmap(stream.fileno(),0,access=mmap.ACCESS_READ) as data:meta=metadata(data)\n        if not meta.get('datetime','').startswith('2026:10:28 '):raise ValueError('Unexpected capture date')\n        frames.append(dict(path=str(path),sha256=sha256(path),size=stat.st_size,mtime_ns=stat.st_mtime_ns,metadata=meta))\n    bursts=group_bursts(frames)\n    now=datetime.now(timezone.utc)\n    freeze=ROOT/'docs/validation/raw'/f'gel-rafales-carte-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    protocol=dict(schema_version=1,data_version=1,started_at_utc=started.isoformat(),frozen_at_utc=now.isoformat(),\n        frames=frames,groups=[[f['path'] for f in g] for g in bursts],\n        runner_sha256=sha256(Path(__file__)),runner_source=Path(__file__).read_text(encoding='utf-8'),\n        grouping='Filename order, same model/ISO/exposure/aperture/focal/lens; adjacent camera timestamps gap <=4s. Candidate burst boundaries, NOT confirmed illumination levels.',\n        selection='All 72 explicitly scoped new files. Three 256x256 visible CFA crops at x20/50/80%, center height. No previous sealed burst files opened. No fit or threshold optimization, descriptive inventory only.')\n    with freeze.open('x',encoding='utf-8') as handle:json.dump(protocol,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('FROZEN',freeze,'groups',len(bursts),flush=True)\n    records=[]\n    for gi,group in enumerate(bursts):\n        crops=[];decoder=[];geometry=None\n        for frame in group:\n            path=Path(frame['path']);before=path.stat()\n            if (before.st_size,before.st_mtime_ns)!=(frame['size'],frame['mtime_ns']):raise ValueError('Card input changed before decoding')\n            with rawpy.imread(str(path)) as raw:\n                if raw.raw_pattern is None or raw.raw_pattern.shape!=(2,2):raise ValueError('Only Bayer supported')\n                m=raw.raw_image_visible;h,w=m.shape\n                if min(h,w)<512:raise ValueError('Insufficient image dimensions')\n                pattern=raw.raw_pattern.tolist()\n                current=(h,w,pattern)\n                if geometry is not None and geometry!=current:raise ValueError('Geometry changed within burst')\n                geometry=current\n                boxes=[((h//2-128)//2*2,(int(w*f)-128)//2*2) for f in (.2,.5,.8)]\n                crops.append(np.stack([m[y:y+256,x:x+256].copy() for y,x in boxes]))\n                desc=raw.color_desc.decode('ascii')\n                decoder.append(dict(path=str(path),shape=[h,w],cfa=pattern,color_desc=desc,\n                    black_level_per_channel=list(raw.black_level_per_channel),white_level=int(raw.white_level),\n                    crop_mosaic_yx=[list(p) for p in boxes]))\n            after=path.stat()\n            if (after.st_size,after.st_mtime_ns)!=(frame['size'],frame['mtime_ns']) or sha256(path)!=frame['sha256']:\n                raise ValueError('Card input changed during decode')\n        planes=[];iso=group[0]['metadata']['iso']\n        if len(crops)>=2:\n            stack=np.stack(crops).astype(np.float64)\n            for roi in range(3):\n                green=0\n                for dy,dx in ((0,0),(0,1),(1,0),(1,1)):\n                    name=decoder[0]['color_desc'][geometry[2][dy][dx]]\n                    if name=='G':green+=1;name='G'+str(green)\n                    data=stack[:,roi,dy::2,dx::2]\n                    moments=stack_moments(data)\n                    dark=darks.get((iso,name))\n                    signal=float(data.mean())-dark['empirical_black_dn'] if dark else None\n                    pairs=[]\n                    for a,b in combinations(range(len(group)),2):\n                        pairs.append(dict(left=group[a]['path'],right=group[b]['path'],**pair_stats(data[a],data[b])))\n                    planes.append(dict(roi=roi,plane=name,offset=[dy,dx],**moments,\n                        prior_empirical_black_dn=dark['empirical_black_dn'] if dark else None,\n                        prior_dark_variance_dn2=dark['dark_variance_dn2'] if dark else None,\n                        candidate_signal_dn=signal,\n                        candidate_signal_in_prior_dark_sigma=signal/np.sqrt(dark['dark_variance_dn2']) if dark else None,\n                        useful_mean_range_fraction=moments['mean_range_dn']/max(abs(signal),1) if signal is not None else None,\n                        near_white_fraction=float((data>=.98*min(d['white_level'] for d in decoder)).mean()),\n                        pair_diagnostics=pairs))\n        record=dict(group_index=gi,paths=[f['path'] for f in group],frames=len(group),metadata=group[0]['metadata'],\n            decoder=decoder,planes=planes,status='descriptive_only' if planes else 'insufficient_repetitions')\n        records.append(record)\n        print('GROUP',gi,Path(group[0]['path']).stem,Path(group[-1]['path']).stem,'ISO',iso,'N',len(group),\n            'R signal/sigma',[round(p['candidate_signal_in_prior_dark_sigma'],2) if p['candidate_signal_in_prior_dark_sigma'] is not None else None for p in planes if p['plane']=='R'],flush=True)\n    if sha256(parent)!=parent_hash:raise ValueError('Historical reference changed')\n    now=datetime.now(timezone.utc)\n    output=ROOT/'docs/validation/raw'/f'qualification-rafales-carte-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result=dict(schema_version=1,data_version=1,started_at_utc=started.isoformat(),completed_at_utc=now.isoformat(),\n        freeze=dict(path=str(freeze),sha256=sha256(freeze)),parent=dict(path=str(parent),sha256=parent_hash),records=records,\n        commit=git('rev-parse','HEAD'),versions=dict(python=platform.python_version(),numpy=np.__version__,rawpy=rawpy.__version__,libraw=list(rawpy.libraw_version)),\n        units='Decoded visible CFA DN and DN^2, no demosaicing, no normalization, black not subtracted for variances.',\n        helper_sources={name:dict(sha256=sha256(ROOT/'tests'/name),source=(ROOT/'tests'/name).read_text(encoding='utf-8')) for name in ('audit_noise_pairs.py','audit_canon_metadata.py')},\n        limitations='Capture roles and illumination levels unconfirmed. Prior empirical dark reference from another capture session, unavailable at ISO12800/25600; never substitute declared decoder black as calibrated black. Grouping by timestamp/metadata cannot certify identical scene. Centered temporal variance removes whole-ROI mean changes only, not motion/illumination gradients. Short bursts and temporal correlation prevent clean truth or sensor fixed-pattern identification. No training, no held-out validation claim, no noise coefficients fitted.',\n        verdict='new_raw_burst_inventory_and_variance_qualification_only')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('RESULT',output,flush=True)\n\n\nif __name__=='__main__':run()\n",
 "grouping": "Filename order, same model/ISO/exposure/aperture/focal/lens; adjacent camera timestamps gap <=4s. Candidate burst boundaries, NOT confirmed illumination levels.",
 "selection": "All 72 explicitly scoped new files. Three 256x256 visible CFA crops at x20/50/80%, center height. No previous sealed burst files opened. No fit or threshold optimization, descriptive inventory only."
}