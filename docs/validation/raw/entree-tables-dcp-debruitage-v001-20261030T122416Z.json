{
 "schema": "ipr-dcp-table-input-v001",
 "created_utc": "20261030T122416Z",
 "author": "Claude",
 "engine": {
  "branch": "patch_raw_decoder",
  "commit": "e01fc59039945e96c7aeaa16819bc91adafd8808",
  "probe": "temporary counters in the DCP per-pixel loop (IPR_DCP_PROBE), applied locally, never committed, reverted after the run; diff below",
  "executable_sha256": "d41e0577186f16b1219e943dc48e21fe5e453f6e981f0975696c5d6b12a338fe"
 },
 "measure": "share of pixels whose ProPhoto linear input to the DCP tables (after matrix and baseline exposure) has min < 0 (neg), min < -0.01 (deep_neg), max > 1 (over1); full definition, neutral render, Camera Neutral, optics off. With camera denoise the profile runs twice (development, then the denoised signal): the second pass is kept",
 "states": {
  "A": "application development, no camera denoise",
  "B0": "signed development, strengths 0/0",
  "M50": "single slider 50 (50/98)",
  "M100": "single slider 100 (100/100)"
 },
 "corpus": "28 RAW of tests/image/base and the 9 R7 RAW (7Y6A*) of tests/image/base-hors-protocole",
 "reading": "denoise removes most table-input negatives: deep negatives at M100 are below 0.1 % everywhere except the four R7 files at the highest ISO (7Y6A7317/7331/7547/7579: 1.3-5.1 %, 8-13 % at M50, 20-29 % at B0); shallow negatives that remain are near-black pixels around zero. The earlier D1+D2 trial (essais-bornes-dcp-v001-20261029T133401Z.json) found no visible change on 7Y6A7599 with 6.5 % deep negatives at B0.",
 "decision": "D0 kept (current bounds unchanged); a signed table/curve extension (D1/D2) would only concern the frozen extreme-ISO R7 corpus at low denoise strengths",
 "scripts_sha256": {
  "dcp_probe.py": "98da2791d0aaab9e8a23ea4b2b4c3db6f07f2070ee12c7bc8d01e2a9e47d3eb2"
 },
 "scripts_source": {
  "dcp_probe.py": "\"\"\"Share of pixels whose ProPhoto input to the DCP tables leaves [0, 1], with a temporary\nengine probe (IPR_DCP_PROBE, never committed). States: A (application development),\nB0 (signed, no denoise), master 50 and 100 (CameraDenoise::settingsFromAmount).\"\"\"\nimport json, os, sys, time\nfrom pathlib import Path\nsys.path.insert(0, str(Path(__file__).parent))\nprobe = Path(__file__).parent / \"dcp_probe.log\"\nos.environ[\"IPR_DCP_PROBE\"] = str(probe)\nfrom strength_law import RenderServer, ROOT  # noqa: E402\n\ndef law(m):\n    return m, round(100 * (1 - (1 - m / 100) ** 6))\n\nSTATES = {\"A\": None, \"B0\": (0, 0), \"M50\": law(50), \"M100\": law(100)}\nexe = Path(sys.argv[1]); out = Path(sys.argv[2])\nraws = [p for p in sorted((ROOT / \"tests/image/base\").iterdir()) if p.suffix.upper() in (\".CR3\", \".CR2\")]\nraws += [p for p in sorted((ROOT / \"tests/image/base-hors-protocole\").iterdir()) if p.suffix.upper() == \".CR3\" and p.stem.startswith(\"7Y6A\")]\nreport = json.loads(out.read_text()) if out.exists() else {}\nwith RenderServer(exe, timeout=900) as server:\n    for raw in raws:\n        key = f\"{raw.parent.name}/{raw.stem}\"\n        if key in report: continue\n        t0 = time.time(); entry = {}\n        for name, st in STATES.items():\n            before = probe.read_text().splitlines() if probe.exists() else []\n            kw = {} if st is None else {\"camera_denoise\": {\"luminance\": st[0], \"chrominance\": st[1]}}\n            server.render(raw, \"neutral\", 0, **kw)\n            lines = (probe.read_text().splitlines() if probe.exists() else [])[len(before):]\n            rows = [list(map(int, l.split())) for l in lines]\n            if not rows: entry[name] = None; continue\n            w, h, neg, deep, over = max(rows, key=lambda r: r[0] * r[1])\n            n = w * h\n            entry[name] = {\"size\": [w, h], \"calls\": len(rows), \"neg\": neg / n, \"deep_neg\": deep / n, \"over1\": over / n,\n                           \"denoise\": None if st is None else list(st)}\n        report[key] = entry\n        out.write_text(json.dumps(report, indent=1))\n        print(key, f\"{time.time() - t0:.0f}s\", {k: (round(v['neg'] * 100, 3), round(v['deep_neg'] * 100, 3)) if v else None for k, v in entry.items()}, flush=True)\n",
  "probe.diff": "diff --git a/src/profiles/CameraProfileEngine.cpp b/src/profiles/CameraProfileEngine.cpp\nindex c03aa08..87be373 100644\n--- a/src/profiles/CameraProfileEngine.cpp\n+++ b/src/profiles/CameraProfileEngine.cpp\n@@ -1,3 +1,6 @@\n+#include <atomic>\n+#include <cstdio>\n+#include <cstdlib>\n #include \"CameraProfileEngine.h\"\n #include \"WorkingColorSpace.h\"\n \n@@ -560,11 +563,14 @@ public:\n                          toneCurve[toneCurve.size() - 2] == 1.0;\n         for (qsizetype i = 1; hueStable && i < toneCurve.size(); i += 2)\n             hueStable = toneCurve[i] >= 0.0 && toneCurve[i] <= 1.0;\n+        std::atomic<long long> probeNeg{0}, probeDeep{0}, probeOver{0};\n         cv::parallel_for_(cv::Range(0, rgb.rows), [&](const cv::Range &rows) {\n+            long long localNeg = 0, localDeep = 0, localOver = 0;\n             for (int y = rows.start; y < rows.end; ++y) {\n                 cv::Vec3f *row = rgb.ptr<cv::Vec3f>(y);\n                 for (int x = 0; x < rgb.cols; ++x) {\n                     const cv::Vec3f in = row[x];\n+                    if (x == 0 && y == rows.end - 1) { probeNeg += localNeg; probeDeep += localDeep; probeOver += localOver; localNeg = localDeep = localOver = 0; }\n                     const double x2 =\n                         cameraToXyz[0] * in[0] + cameraToXyz[1] * in[1] +\n                         cameraToXyz[2] * in[2];\n@@ -581,6 +587,9 @@ public:\n                         continue;\n                     }\n                     cv::Vec3f out(xyzToProPhoto * (xyz * exposureScale));\n+                    { const float lo = std::min({out[0], out[1], out[2]});\n+                      const float hi = std::max({out[0], out[1], out[2]});\n+                      localNeg += lo < 0.f; localDeep += lo < -0.01f; localOver += hi > 1.f; }\n                     if (!hueMap.isEmpty())\n                         out = applyHueSatMap(out, hueMap, hueSatEncoding);\n                     if (!lookTable.isEmpty())\n@@ -606,7 +615,15 @@ public:\n                     row[x] = cv::Vec3f(proPhotoToWorking * cv::Vec3d(out));\n                 }\n             }\n+            probeNeg += localNeg; probeDeep += localDeep; probeOver += localOver;\n         });\n+        if (const char *probePath = std::getenv(\"IPR_DCP_PROBE\")) {\n+            if (FILE *f = std::fopen(probePath, \"a\")) {\n+                std::fprintf(f, \"%d %d %lld %lld %lld\\n\", rgb.cols, rgb.rows,\n+                             probeNeg.load(), probeDeep.load(), probeOver.load());\n+                std::fclose(f);\n+            }\n+        }\n         return true;\n     }\n \n"
 },
