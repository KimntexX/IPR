 "runner_source": "\"\"\"Freeze band-transfer diagnostic on development, then open validation exactly once.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport rawpy\nimport cv2\nfrom analysis.render import available_memory\nfrom extract_noise_burst_native import run as extract_native\nfrom study_noise_burst_motion import preview,estimate\nfrom study_noise_burst_residuals import temporal_basis\nfrom study_noise_burst_bands import bands\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\nROIS=(0,2,5)\nMETRICS=('sigma_haar_to_pixel','sigma_fine_to_haar','sigma_medium_to_fine')\n\n\ndef run():\n    started=datetime.now(timezone.utc);cv2.setNumThreads(2);cv2.setRNGSeed(440)\n    parent=ROOT/'docs/validation/raw/bandes-reelles-rafale-bruit-v001-20261027T230949Z.json'\n    audit=ROOT/'docs/validation/raw/audit-rafale-reelle-bruit-v001-20261027T225328Z.json'\n    develop=json.loads(parent.read_text(encoding='utf-8'));raw_audit=json.loads(audit.read_text(encoding='utf-8'))\n    existing=list((ROOT/'docs/validation/raw').glob('gel-transfert-bandes-rafale-bruit-v001-*.json'))\n    if existing:raise ValueError('Validation freeze already exists: inspect it, do NOT rerun or retune')\n    freeze=ROOT/'docs/validation/raw'/f'gel-transfert-bandes-rafale-bruit-v001-{started.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    frozen=dict(schema_version=1,data_version=1,created_at_utc=started.isoformat(),\n        parent=dict(path=str(parent),sha256=sha256(parent)),audit=dict(path=str(audit),sha256=sha256(audit)),\n        validation_partition='validation',indices=list(range(14,28)),sealed_indices=list(range(28,42)),\n        native_extractor_sha256=sha256(ROOT/'tests/extract_noise_burst_native.py'),\n        validator_sha256=sha256(Path(__file__)),validator_source=Path(__file__).read_text(encoding='utf-8'),\n        roi_indices=list(ROIS),metrics=list(METRICS),relative_error_limit=.10,\n        predictions=[dict(region=r,channels=develop['records'][r]['native_linear']) for r in ROIS],\n        criterion='Exploratorywithinburstrepeatabilityonly:27metrics(3ROIs*3planes*3ratios),allabsrelativeerror<=10%. Not productquality threshold or population coverage. No refit after opening validation. Sealed14 remainclosed.',\n        rules='Freeze complete BEFORE validation pixel decode. Nativegrid0/2/5fromscenegeometry. Same rawpreviewmotiondesignandnativebands as development. OnecameraISO4000sameburst;not independentcamera/scene validation.')\n    with freeze.open('x',encoding='utf-8') as handle:json.dump(frozen,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    freeze_hash=sha256(freeze);print('FREEZE',freeze,flush=True)\n    native_path=extract_native('validation',freeze);native=json.loads(native_path.read_text(encoding='utf-8'))\n    archive=Path(native['pixels']['path'])\n    if sha256(archive)!=native['pixels']['sha256']:raise ValueError('Changed validation pixels')\n    with np.load(archive,allow_pickle=False) as data:planes=data['planes'].copy()\n    motion=[];reference=None\n    for item in raw_audit['identities']:\n        if item['split']!='validation':continue\n        if (available_memory() or 0)<2*1024**3:raise ValueError('Need2GiB for RAW preview motion audit')\n        p=Path(item['path'])\n        if sha256(p)!=item['sha256']:raise ValueError('Changed validation source')\n        with rawpy.imread(str(p)) as raw:current,scale=preview(raw.raw_image_visible)\n        if reference is None:reference=current.copy()\n        m=estimate(reference,current);m.update(index=item['index'],sha256=item['sha256'],preview_to_cfa_plane_scale=scale)\n        motion.append(m)\n    basis=temporal_basis([r['reference_to_frame_preview_affine'] for r in motion]);records=[];failures=[]\n    for prediction in frozen['predictions']:\n        roi=prediction['region'];measured=bands(planes[:,roi],basis);errors=[]\n        for channel in range(3):\n            errors.append({name:measured[channel][name]/pr