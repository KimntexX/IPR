 "commit": "2a40c5c6cff78d40294393a68827f4a24555c724",
 "runner_sha256": "f61c36ba6e5fa9e619d95a8a4fbc464aa26bc1b928102ed2e0cce369d2977dd6",
 "runner_source": "\"\"\"Summarize spatial sampling coverage and leave-one-context stability, not noise truth.\"\"\"\nfrom datetime import datetime, timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom study_noise_neighbourhoods import ROOT, sha256, git\n\n\ndef leave_one_context(tiles, tone, axis):\n    accepted = [t for t in tiles if t['bin'] == tone and t['accepted'][axis]]\n    if len(accepted) < 16: return dict(status='unavailable', accepted=len(accepted))\n    median = float(np.median([t['mad'][axis] for t in accepted]))\n    if median <= 1e-12: return dict(status='unmeasurable', accepted=len(accepted))\n    ratios = []; lost = []\n    for label in sorted({t['label'] for t in tiles}):\n        remaining = [t['mad'][axis] for t in accepted if t['label'] != label]\n        if len(remaining) < 16: lost.append(label)\n        else: ratios.append(float(np.median(remaining)/median))\n    return dict(status='measured_not_confidence_interval', accepted=len(accepted),\n        distinct_contributing_contexts=len({t['label'] for t in accepted}),\n        context_exclusions_losing_availability=lost,\n        minimum_ratio=min(ratios) if ratios else None, maximum_ratio=max(ratios) if ratios else None)\n\n\ndef run():\n    records = []; parents = []\n    for name in ('6V1A0513', '6V1A9890', '6V1A9426', '6V1A0195'):\n        matches = list((ROOT/'docs/validation/raw').glob('couverture-grille-photo-bruit-v002-'+name+'-*.json'))\n        if len(matches) != 1: raise ValueError('Require exactly one completed evidence per scene: '+name)\n        path = matches[0]; digest = sha256(path); data = json.loads(path.read_text(encoding='utf-8'))\n        row = data['record']; grid = row['grid']; baseline = row['baseline']\n        stability = []\n        for estimate in grid['sigma_rows']:\n            if not estimate['usable']: continue\n            previous = next((r for r in baseline['sigma_rows'] if r['bin'] == estimate['bin'] and r['usable']), None)\n            stability.append(dict(bin=estimate['bin'], sigma=estimate['sigma'],\n                ratio_to_baseline=(np.asarray(estimate['sigma'])/previous['sigma']).tolist() if previous else None,\n                axes=[leave_one_context(grid['tiles'], estimate['bin'], axis) for axis in range(3)]))\n        comparison = [dict(label=label, before=before['covered_blocks'], after=grid['coverage'][label]['covered_blocks'],\n                           total=225) for label, before in baseline['coverage'].items()]\n        records.append(dict(raw=row['raw'], actual_iso=row['actual_iso'], assumed_psd_iso=row['assumed_psd_iso'],\n            grid_contexts=len(row['grid_samples']), excluded_grid_contexts=len(row['excluded_grid_samples']),\n            maximum_replay_error=max(r['maximum_pixel_absolute_error'] for r in row['replay']),\n            coverage=comparison, stability=stability, shortages=grid['shortage']))\n        parents.append(dict(path=str(path), sha256=digest))\n        for r in comparison: print(name, r['label'], r['before'], '->', r['after'], '/225', flush=True)\n    now = datetime.now(timezone.utc)\n    target = ROOT/'docs/validation/raw'/f'bilan-couverture-grille-photo-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    if any(sha256(Path(p['path'])) != p['sha256'] for p in parents): raise ValueError('Changed evidence')\n    result = dict(schema_version=1, data_version=1, completed_at_utc=now.isoformat(), records=records,\n        parents=parents, commit=git('rev-parse', 'HEAD'), runner_sha256=sha256(Path(__file__)),\n        runner_source=Path(__file__).read_text(encoding='utf-8'),\n        rules='Exactly4completed native-coverage scenes. Leaveoneestimationcontext diagnostic uses unchanged16tile rule;selectedtile decisions unchanged,no tuning or denoising.',\n        limitations='Spatial medians stability is NOT confidence interval or validation of true sigma. Consistently biased textures may pass. Context/tone populations differ from baseline;coverage is not noise/detail quality. No pooling across scenes or filling absent axes/tones.')\n    with target.open('x', encoding='utf-8') as handle: json.dump(result, handle, ensure_ascii=False, indent=1, allow_nan=False)\n    print(target)\n\n\nif __name__ == '__main__': run()\n",
 "rules": "Exactly4completed native-coverage scenes. Leaveoneestimationcontext diagnostic uses unchanged16tile rule;selectedtile decisions unchanged,no tuning or denoising.",
 "limitations": "Spatial medians stability is NOT confidence interval or validation of true sigma. Consistently biased textures may pass. Context/tone populations differ from baseline;coverage is not noise/detail quality. No pooling across scenes or filling absent axes/tones."
