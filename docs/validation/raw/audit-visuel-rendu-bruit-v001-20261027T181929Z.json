 "runner_sha256": "c4ca1dcca4658272bea25dba0e9cdf65bd88636dcc454f8b9e8a407547075b7d",
 "runner_source": "\"\"\"Audit visual-render differences, NOT functional TIFF measurements or noise-quality scores.\"\"\"\nfrom datetime import datetime, timezone\nimport json\nfrom pathlib import Path\n\nimport cv2\nimport numpy as np\nfrom study_noise_neighbourhoods import ROOT, sha256, git\n\n\ndef differences(a, b):\n    if a.shape != b.shape or a.shape != (96, 96, 3) or a.dtype != np.uint16 or b.dtype != np.uint16:\n        raise ValueError('Matched native96 RGB16 render artifacts required')\n    # OpenCV BGR order is irrelevant to these channel-pooled distances.\n    delta = np.abs(a.astype(float)-b.astype(float))\n    areas = {'whole': np.s_[:, :], 'top_left': np.s_[:48, :48],\n             'top_right': np.s_[:48, 48:], 'bottom_left': np.s_[48:, :48],\n             'bottom_right': np.s_[48:, 48:]}\n    return {name: dict(changed_pixel_fraction=float(np.mean(np.any(delta[area] > 0, axis=2))),\n            mean_abs_code16=float(delta[area].mean()), maximum_abs_code16=int(delta[area].max()),\n            mean_abs_equivalent_code8=float(delta[area].mean()/257.),\n            maximum_abs_equivalent_code8=float(delta[area].max()/257.)) for name, area in areas.items()}\n\n\ndef run():\n    parent = ROOT/'docs/validation/raw/rendu-experimental-cible-equilibree-bruit-v003-20261027T175652Z.json'\n    digest = sha256(parent); data = json.loads(parent.read_text(encoding='utf-8'))\n    observations = dict(floor='Utilisateur : lissage plus propre pour candidate que pilot.',\n        joint='Utilisateur : coin haut droit semble meilleur ; perception incertaine.',\n        sky_points='Utilisateur : aucune différence perçue.',\n        horizon='Utilisateur : candidate semble plus lisse que pilot.')\n    records = []\n    for row in data['records']:\n        arrays = {}; sources = []\n        for export in row['exports']:\n            path = Path(export['path'])\n            if sha256(path) != export['sha256']: raise ValueError('Changed export '+str(path))\n            array = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)\n            if array is None: raise ValueError('Unreadable render artifact')\n            arrays[export['kind']] = array\n            sources.append(dict(path=str(path), sha256=export['sha256']))\n        records.append(dict(raw=row['raw'], label=row['label'], render_audit=row['audit'],\n            user_observation=observations[row['label']], sources=sources,\n            original_to_pilot=differences(arrays['original'], arrays['pilot']),\n            pilot_to_candidate=differences(arrays['pilot'], arrays['candidate'])))\n    if sha256(parent) != digest: raise ValueError('Changed parent evidence')\n    now = datetime.now(timezone.utc)\n    target = ROOT/'docs/validation/raw'/f'audit-visuel-rendu-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result = dict(schema_version=1, data_version=1, completed_at_utc=now.isoformat(),\n        commit=git('rev-parse', 'HEAD'), parent=dict(path=str(parent), sha256=digest), records=records,\n        runner_sha256=sha256(Path(__file__)), runner_source=Path(__file__).read_text(encoding='utf-8'),\n        numpy_version=np.__version__, opencv_version=cv2.__version__,\n        rules='Only sanity-check actual visual exports/identity/location;not functional analyzer campaign. Rows have original memory-render provenance;no TIFF IPR promoted to cleantruth or functional input. No new denoising or tuning.',\n        limitations='Code-value distance after fixed clipped sRGB encoding/quantization,not noise reduction,perceptual deltaE,detail preservation or objective quality. More difference is not better;only verifies existence/location of correction. Quoted subjective feedback is not blind validation.')\n    with target.open('x', encoding='utf-8') as handle: json.dump(result, handle, ensure_ascii=False, indent=1, allow_nan=False)\n    print(target)\n    for row in records:\n        print(row['label'], json.dumps(row['pilot_to_candidate'], ensure_ascii=False))\n\n\nif __name__ == '__main__': run()\n",
 "numpy_version": "2.4.2",
 "opencv_version": "5.0.0",
