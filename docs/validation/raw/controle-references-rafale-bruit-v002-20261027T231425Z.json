 "preview": {
  "path": "C:\\Users\\victo\\Documents\\Projet\\Programmation\\IPR\\.worktrees\\patch_noise\\build-patch_noise\\burst-review\\20261027T231423Z\\production-reference-controls.png",
  "sha256": "b93ba076091b7199a3712c47b9c5323520c21a74b708f369d9d15e43f0f59850",
  "display": "Rec2020linear->linearSRGBmatrixfromWorkingColorSpace.h,clip[0,1]thenIEC sRGB,8bitICC. No auto exposure/gain. Native192px crops,not resized.",
  "working_color_source_sha256": "353365f56eb3223ec64cbc3e5504ba3484d02e34a3dc22fb6b4ebf320c7ec163"
 },
 "runner_source": "\"\"\"Heavy-blur controls and diagnostic contact sheet for the frozen burst references.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport cv2\nfrom PIL import Image,ImageDraw,ImageCms\nfrom study_noise_burst_reference import align\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\n\ndef display(planes):\n    y,co,cg=planes;wy,wg,wb=.2627002120112671,.6779980715188708,.0593017164698620\n    k=wy+.5*wg\n    rgb=np.stack((y+(1-k)*co-wg*cg,y+(.5-k)*co+(1-wg)*cg,y-k*co-wg*cg),axis=-1)\n    r2020=np.array([[.6369580483012914,.1446169035862083,.1688809751641721],\n        [wy,wg,wb],[0.,.0280726930490874,1.060985057710791]])\n    srgb=np.array([[.4123907992659595,.3575843393838779,.1804807884018343],\n        [.2126390058715104,.7151686787677559,.0721923153607337],\n        [.0193308187155919,.1191947797946259,.9505321522496606]])\n    linear=np.clip(rgb@(np.linalg.inv(srgb)@r2020).T,0,1)\n    encoded=np.where(linear<=.0031308,12.92*linear,1.055*linear**(1/2.4)-.055)\n    return np.clip(np.rint(encoded*255),0,255).astype(np.uint8)\n\n\ndef run():\n    started=datetime.now(timezone.utc)\n    source=ROOT/'docs/validation/raw/references-croisees-rafale-bruit-v001-20261027T230909Z.json'\n    witness=json.loads(source.read_text(encoding='utf-8'));parents=witness['parents']\n    data=[json.loads(Path(p['path']).read_text(encoding='utf-8')) for p in parents]\n    native,production=data;arrays=[]\n    for item in data:\n        p=Path(item['pixels']['path'])\n        if sha256(p)!=item['pixels']['sha256']:raise ValueError('Changed pixels')\n        with np.load(p,allow_pickle=False) as saved:arrays.append(saved['planes'].copy())\n    planes,controls=arrays;rows=[];contact=Image.new('RGB',(5*256,4*240),(35,35,35));draw=ImageDraw.Draw(contact)\n    labels=('Original','IPR 50','IPR 100','Reference 13 (imperfect)','Blur sigma16 (control)')\n    for column,label in enumerate(labels):draw.text((column*256+8,5),label,fill='white')\n    shown=(0,2,4,8)\n    for record in witness['records']:\n        if record['status']!='measured':continue\n        target=record['target_index'];roi=record['region'];ki=next(i for i,r in enumerate(production['records']) if r['index']==target)\n        others=sorted(record['reference_indices_first']+record['reference_indices_second'])\n        aligned=np.stack([align(planes[index,roi],np.asarray(matrix)) for index,matrix in zip(others,record['local_target_to_source_affines'])])[:,:,:,32:-32][:,:,32:-32,:]\n        valid=np.isfinite(aligned).all(axis=(0,1));ra=aligned[::2].mean(axis=0);rb=aligned[1::2].mean(axis=0)\n        original=planes[target,roi].astype(float)\n        blur4=np.stack([cv2.GaussianBlur(p,(0,0),4,borderType=cv2.BORDER_REPLICATE) for p in original])[:,32:-32,32:-32]\n        blur16=np.stack([cv2.GaussianBlur(p,(0,0),16,borderType=cv2.BORDER_REPLICATE) for p in original])[:,32:-32,32:-32]\n        baseline=original[:,32:-32,32:-32]\n        risk=lambda x:np.mean((x[...,valid]-ra[...,valid])*(x[...,valid]-rb[...,valid]),axis=-1)\n        r0=risk(baseline);r4=risk(blur4);r16=risk(blur16)\n        rows.append(dict(target_index=target,region=roi,common_overlap_fraction=float(valid.mean()),\n            original_crossrisk=r0.tolist(),blur4_crossrisk=r4.tolist(),blur16_crossrisk=r16.tolist(),\n            blur4_delta=(r4-r0).tolist(),blur16_delta=(r16-r0).tolist(),\n            warning='Blurringcanreducescoreevenifdetailislost;notproofoptimaldenoising'))\n        if target==0 and roi in shown:\n            row=shown.index(roi);draw.text((8,row*240+23),f'ROI {roi}, native pixels, same exposure',fill='white')\n            ref=(ra+rb)*.5\n            ref=np.where(np.isfinite(ref),ref,baseline)\n            pictures=[controls[0,s,roi,:,32:-32,32:-32] for s in range(3)]+[ref,blur16]\n            for column,picture in enumerate(pictures):contact.paste(Image.fromarray(display(picture)),(column*256+32,row*240+40))\n    folder=ROOT/'build-patch_noise/burst-review'/started.strftime('%Y%m%dT%H%M%SZ');folder.mkdir(parents=True,exist_ok=False)\n    picture=folder/'production-reference-controls.png'\n    profile=ImageCms.ImageCmsProfile(ImageCms.createProfile('sRGB')).tobytes()\n    contact.save(picture,icc_profile=profile)\n    now=datetime.now(timezone.utc);output=ROOT/'docs/validation/raw'/f'controle-references-rafale-bruit-v002-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    previous=ROOT/'docs/validation/raw/controle-references-rafale-bruit-v001-20261027T231257Z.json'\n    result=dict(schema_version=1,data_version=2,started_at_utc=started.isoformat(),completed_at_utc=now.isoformat(),\n        correction=dict(parent=str(previous),sha256=sha256(previous),reason='Canvas240instead220perrow:previouspreviewcropped12bottompixels. Sameanalyticalcontrolsnotnewindependentstudy.'),\n        parent=dict(path=str(source),sha256=sha256(source)),records=rows,\n        preview=dict(path=str(picture),sha256=sha256(picture),display='Rec2020linear->linearSRGBmatrixfromWorkingColorSpace.h,clip[0,1]thenIEC sRGB,8bitICC. No auto exposure/gain. Native192px crops,not resized.',working_color_source_sha256=sha256(ROOT/'src/core/WorkingColorSpace.h')),\n        runner_source=Path(__file__).read_text(encoding='utf-8'),runner_sha256=sha256(Path(__file__)),commit=git('rev-parse','HEAD'),\n        rules='Readonly existingdevelopmentpixels. Fixed Gaussian sigma4/16 diagnostic overblurcontrols,not candidates or truth. No refit/reference reselection/holdout opening.',\n        limitations='Negative controls probe metric selectivity,not universal badfilters:blurmaylegitimatelyhelpstronglynoisyflats. No exactclean reference,visualuserrevieworLRcomparison. No production change.',\n        verdict='reference_metric_selectivity_audit')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('RESULT',output,'PREVIEW',picture,flush=True)\n    for roi in range(9):\n        rs=[r for r in rows if r['region']==roi]\n        if rs:print('ROI',roi,'BLUR16delta%',(100*np.mean([r['blur16_delta'] for r in rs],axis=0)/np.maximum(np.mean([r['original_crossrisk'] for r in rs],axis=0),1e-20)).round(1).tolist(),flush=True)\n\n\nif __name__=='__main__':run()\n",
