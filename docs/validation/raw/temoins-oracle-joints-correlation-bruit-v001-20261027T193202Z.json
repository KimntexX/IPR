 "runner_source": "\"\"\"Verify simultaneous oracle witnesses from saved capacity trials, without rerunning or fitting.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\n\ndef run():\n    path=ROOT/'docs/validation/raw/capacite-jointe-segment-correlation-bruit-v001-20261027T193011Z.json'\n    digest=sha256(path);parent=json.loads(path.read_text(encoding='utf-8'));records=[]\n    for row in parent['records']:\n        trials=[]\n        for trial in row['trials']:\n            q=[sum(c*e['weight']**i for i,c in enumerate(e['shape_quadratic'])) for e in trial['evaluations']]\n            h=[e['penalized_minimum']-trial['penalty']*v for e,v in zip(trial['evaluations'],q)]\n            shape,hh=float(np.mean(q)),float(np.mean(h))\n            passed=shape<row['shape_budget']-1e-12 and hh<row['hh_limit']-1e-12\n            trials.append(dict(penalty=trial['penalty'],mean_shape_error=shape,mean_hh_error=hh,\n                simultaneously_beats_both_controls=passed,\n                oracle_weights=[dict(rect=e['rect'],weight=e['weight']) for e in trial['evaluations']]))\n        witness=next((t for t in trials if t['simultaneously_beats_both_controls']),None)\n        records.append(dict(dataset=row['dataset'],iso=row['iso'],a=row['a'],shape_limit=row['shape_budget'],\n            hh_limit=row['hh_limit'],all_saved_trials=trials,verified_witness=witness))\n        print('Joint witness',row['dataset'],row['iso'],'found',witness is not None,\n            'penalty',witness['penalty'] if witness else None,flush=True)\n    if sha256(path)!=digest:raise ValueError('Changed capacity evidence')\n    now=datetime.now(timezone.utc)\n    output=ROOT/'docs/validation/raw'/f'temoins-oracle-joints-correlation-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result=dict(schema_version=1,data_version=1,completed_at_utc=now.isoformat(),records=records,\n        verdict='joint_oracle_witness_on_all_four_folds_not_a_predictor' if all(r['verified_witness'] is not None for r in records) else 'joint_oracle_witnesses_incomplete',\n        parent=dict(path=str(path),sha256=digest),runner_sha256=sha256(Path(__file__)),\n        runner_source=Path(__file__).read_text(encoding='utf-8'),numpy_version=np.__version__,commit=git('rev-parse','HEAD'),\n        rules='Arithmetic verification ONLY of ALLsavedcapacitytrials;no newmodels/weightfitting. For a given savedweight vector,checkshape and HH jointlystrictlybelow minimum(fixed,nearest)capturelimits. Firstpassing trial retained asoracleexistencewitness;not a selectedimagealgorithm or regularizationparameter.',\n        limitations='UsesheldDtruth inORACLEcapacity stage;not blindnoiseestimation,independentvalidation or proof ofperceptualgain. Floatingpointnot formalintervalcertificate. Fourreusedcaptures/14quadrants only. Oracleweights and penalties mustnot becomeproductionsettings.')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('VERDICT',result['verdict'],output,flush=True)\n\n\nif __name__=='__main__':run()\n",
