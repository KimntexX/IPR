 "runner_source": "\"\"\"Measure actual RAW/native temporal residual energy in production denoising bands.\"\"\"\nfrom datetime import datetime,timezone\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport cv2\nfrom study_noise_burst_residuals import residual\nfrom study_noise_neighbourhoods import ROOT,sha256,git\n\n\ndef haar(a):\n    return (a[...,::2,::2]-a[...,::2,1::2]-a[...,1::2,::2]+a[...,1::2,1::2])*.5\n\n\ndef bands(stack,basis):\n    e=residual(stack,basis);n,c,h,w=e.shape;dof=n-basis.shape[1];result=[]\n    for channel in range(c):\n        x=e[:,channel];fine=[];medium=[]\n        for frame in x:\n            g0=cv2.GaussianBlur(frame,(0,0),.8,borderType=cv2.BORDER_REPLICATE)\n            g1=cv2.GaussianBlur(frame,(0,0),1.8,borderType=cv2.BORDER_REPLICATE)\n            fine.append(frame-g0);medium.append(g0-g1)\n        interior=x[:,8:-8,8:-8];hh=haar(interior)\n        energy=lambda a:float(np.sum(np.asarray(a)**2)/(dof*np.prod(np.asarray(a).shape[1:])))\n        v=energy(interior);vh=energy(hh)\n        vf=energy(np.asarray(fine)[:,8:-8,8:-8]);vm=energy(np.asarray(medium)[:,8:-8,8:-8])\n        result.append(dict(variance_pixel=v,variance_haar_hh=vh,variance_fine=vf,variance_medium=vm,\n            sigma_haar_to_pixel=float(np.sqrt(vh/max(v,1e-30))),\n            sigma_fine_to_haar=float(np.sqrt(vf/max(vh,1e-30))),\n            sigma_medium_to_fine=float(np.sqrt(vm/max(vf,1e-30)))))\n    return result\n\n\ndef run():\n    started=datetime.now(timezone.utc)\n    names=('audit-rafale-reelle-bruit-v001-20261027T225328Z.json',\n        'extraction-native-rafale-bruit-v001-20261027T230112Z.json',\n        'residus-rafale-bruit-v001-20261027T230219Z.json')\n    paths=[ROOT/'docs/validation/raw'/n for n in names];hashes=[sha256(p) for p in paths]\n    raw,native,model=[json.loads(p.read_text(encoding='utf-8')) for p in paths];arrays=[]\n    for p,key in ((raw,'mosaic'),(native,'planes')):\n        archive=Path(p['pixels']['path'])\n        if sha256(archive)!=p['pixels']['sha256']:raise ValueError('Changed pixels')\n        with np.load(archive,allow_pickle=False) as saved:arrays.append(saved[key].copy())\n    mosaic,planes=arrays;basis=np.asarray(model['basis']);records=[]\n    for roi in range(9):\n        cfa=np.stack([mosaic[:,roi,y::2,x::2] for y,x in ((0,0),(0,1),(1,0),(1,1))],axis=1)\n        records.append(dict(region=roi,raw_dn=bands(cfa,basis),native_linear=bands(planes[:,roi],basis)))\n    if hashes!=[sha256(p) for p in paths]:raise ValueError('Parents changed')\n    now=datetime.now(timezone.utc);output=ROOT/'docs/validation/raw'/f'bandes-reelles-rafale-bruit-v001-{now.strftime(\"%Y%m%dT%H%M%SZ\")}.json'\n    result=dict(schema_version=1,data_version=1,started_at_utc=started.isoformat(),completed_at_utc=now.isoformat(),\n        parents=[dict(path=str(p),sha256=h) for p,h in zip(paths,hashes)],records=records,\n        runner_source=Path(__file__).read_text(encoding='utf-8'),runner_sha256=sha256(Path(__file__)),\n        numpy_version=np.__version__,opencv_version=cv2.__version__,commit=git('rev-parse','HEAD'),\n        rules='NewrealburstdevelopmentONLY;sametemporalnuisanceprojectionandN-rankdof. No resampling. Compareenergyof pixel,orthonormal2x2HaarHH,fine(I-Gsigma.8),medium(G.8-G1.8);border8excluded. ScalarvarianceunitsDN2orlinearRec2020plane2. Filtersmatchproductionbands,not full nonlinear production denoiser.',\n        limitations='Residuals not certified noisetruth;motioncanremainandtemporallycorrelatednoiseberemoved. Ratiosareconditionaldiagnostics,not perbodymultipliers. RAW/nativegridrotated,not matchedpixels. HHvarianceisnotMAD;GaussianMADcalibrationnotassumed. No coefficienttuningorqualityclaim.',\n        verdict='measured_band_transfer_on_new_real_burst_not_calibrated_production_profile')\n    with output.open('x',encoding='utf-8') as handle:json.dump(result,handle,ensure_ascii=False,indent=1,allow_nan=False)\n    print('RESULT',output,flush=True)\n    for r in records:\n        print('ROI',r['region'],'RAWhaar/pixel',[round(c['sigma_haar_to_pixel'],3) for c in r['raw_dn']],\n            'nativehaar/pixel',[round(c['sigma_haar_to_pixel'],3) for c in r['native_linear']],\n            'nativeMED/FINE',[round(c['sigma_medium_to_fine'],3) for c in r['native_linear']],flush=True)\n\n\nif __name__=='__main__':run()\n",
