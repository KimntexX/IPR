 "reading": [
  "V1 and V2 remove the chroma increase of luminance 100 alone (7599 dark 19.5 -> 15.4/15.2, mid_flat 26.5 -> 19.4/19.2, edges 28.9 -> 22.9/22.8): mechanism confirmed, likely source of the red/green dots reported by the user",
  "V2 breaks 100/100 (7599 mid_flat chroma 6.5 -> 19.9): the chroma stages, still on raw axes, also remove part of the WB-neutral noise; the basis is then inconsistent",
  "V1 keeps 100/100 (6.5 -> 6.7) and improves chrominance 100 alone (7599 dark 6.8 -> 4.2, mid_flat 17.3 -> 11.9, edges 18.6 -> 14.6; IMG_8473 dark 2.2 -> 1.1; 6V1A9539 dark 2.2 -> 1.3)",
  "three scenes for V1 and four for V2, two of them noisy; not a qualification; no code kept (source restored)"
 ],
 "scripts_sha256": {
  "neutral_luma_probe.py": "a29a91200dd22cc529a65c7a1b5f42ee58d67189a08b7cc4d40e7b930f41acff",
  "strength_law.py": "6a2908cc02c68eef0648855ecacaa702935c61c275c363b4a7303b671a03f914",
  "probe_evidence.py": "943f7b0ef8d8fdfa8b22fd61bb1c87b32d06cd735633f5ba12d8b6df0aa9fcb8"
 },
 "scripts_source": {
  "neutral_luma_probe.py": "\"\"\"Probe: camera-signal denoise with the luminance delta neutral in WB space (V2), against the\nmeasured B values of the strength-law JSON. Usage: python neutral_luma_probe.py EXE JSON OUT scene...\"\"\"\nimport json, sys\nfrom pathlib import Path\nimport numpy as np\nsys.path.insert(0, str(Path(__file__).parent))\nfrom strength_law import BASE, RenderServer, masks, metrics, read8  # noqa: E402\n\nexe, doc, out = Path(sys.argv[1]), json.loads(Path(sys.argv[2]).read_text(encoding=\"utf-8\")), Path(sys.argv[3])\nreport = {}\nwith RenderServer(exe, timeout=900) as server:\n    for scene in sys.argv[4:]:\n        s = doc[\"scenes\"][scene]\n        ca = s[\"masks\"][\"common_area\"]\n        (lx, ly), (ix, iy), (w, h) = ca[\"lr_origin_xy\"], ca[\"ipr_origin_xy\"], ca[\"size_wh\"]\n        m = masks(read8(BASE / \"neutre\" / f\"{scene}.tif\")[ly:ly + h, lx:lx + w])\n        raw = next(p for p in BASE.iterdir() if p.stem == scene and p.suffix.upper() in (\".CR3\", \".CR2\"))\n        report[scene] = {}\n        for key in (\"100/0/0\", \"0/100/0\", \"100/100/0\"):\n            lum, col, _ = map(int, key.split(\"/\"))\n            im = server.render(raw, \"neutral\", 0, camera_denoise={\"luminance\": lum, \"chrominance\": col})[0]\n            report[scene][key] = metrics(im[iy:iy + h, ix:ix + w].astype(np.float32) / 257.0, m)\n            for z, v in report[scene][key].items():\n                b, b0, lr = s[\"measures\"][\"B\"][key][z], s[\"measures\"][\"B\"][\"0/0/0\"][z], s[\"measures\"][\"LR\"][key][z]\n                print(f\"{scene} {key} {z:11s} B0 {b0['luma_noise']:5.1f}/{b0['chroma_noise']:5.1f}  B {b['luma_noise']:5.1f}/{b['chroma_noise']:5.1f}\"\n                      f\"  V2 {v['luma_noise']:5.1f}/{v['chroma_noise']:5.1f}  LR {lr['luma_noise']:5.1f}/{lr['chroma_noise']:5.1f}\", flush=True)\nout.write_text(json.dumps(report, indent=1))\n"
 },
