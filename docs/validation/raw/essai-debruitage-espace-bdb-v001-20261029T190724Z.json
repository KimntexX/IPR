 "author": "Claude",
 "question": "Does the camera-signal denoise (B) inject chroma when it removes luminance noise, because its opponent decomposition is done in raw sensor units (signal divided by the applied WB gains) while the residual noise after demosaicing (done after WB) is common-mode in WB space?",
 "base": {
  "commit": "ff836660fb7edd5e538470c004d9f0c56e4b240b",
  "reference": "docs/validation/raw/loi-force-bruit-v001-20261029T185322Z.json",
  "masks_and_alignment": "those of the reference (common_area, fixed masks from the Lightroom neutral)",
  "metrics": "luma Rec.709 (8-bit scale); luma_noise = std of luma - Gaussian sigma 2 in the mask; chroma_noise = mean of the same for R-G and B-G; luma = mean in the mask"
 },
 "variants": {
  "B_measured": "CameraDenoise of 7e367b0 unchanged (values from the reference)",
  "V1_wb_space": {
   "change": "gains forced to (1,1,1) in CameraDenoise::apply: estimation, decomposition and reconstruction in the white-balanced camera space",
   "diff": "--- a/src/raw/CameraDenoise.cpp (apply)\n-        const cv::Vec3f gains(float(context.gains[0]), float(.5 * context.gains[1] + .5 * context.gains[3]), float(context.gains[2]));\n+        const cv::Vec3f gains(1.f, 1.f, 1.f); // PROBE V1: decomposition in WB space",
   "executable_sha256": "8e96958d00612276cf4d0d38aa1f21646736486fa688490abc339e3442cd2fdb",
   "scenes": [
