   ]
  },
  "V2_neutral_luma_reconstruction": {
   "change": "estimation and filtering in raw units unchanged; at reconstruction the luminance delta becomes neutral in WB space, chroma deltas unchanged",
   "diff": "--- a/src/raw/CameraDenoise.cpp (apply, reconstruction)\n-                out[x] = in[x] + cv::Vec3f(d[0] + d[1] - .5f * d[2], d[0] + .5f * d[2], d[0] - d[1] - .5f * d[2]).mul(gains);\n+                const float neutral = d[0] / (.25f * inverseGains[0] + .5f * inverseGains[1] + .25f * inverseGains[2]);\n+                out[x] = in[x] + cv::Vec3f(neutral, neutral, neutral) + cv::Vec3f(d[1] - .5f * d[2], .5f * d[2], -d[1] - .5f * d[2]).mul(gains);",
